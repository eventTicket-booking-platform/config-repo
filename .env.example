# Reference only: set these in each consuming service's environment or private .env.
# Config Server does not automatically load this file.

# Local MySQL service-specific accounts
AUTH_DB_USERNAME=
AUTH_DB_PASSWORD=
EVENT_DB_USERNAME=
EVENT_DB_PASSWORD=
BOOKING_DB_USERNAME=
BOOKING_DB_PASSWORD=

# Production MySQL: set independently for each service-owned database
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_DATABASE=
MYSQL_USERNAME=
MYSQL_PASSWORD=

# Auth / Gateway Keycloak configuration
KEYCLOAK_CONFIG_NAME=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_CONFIG_PASSWORD=

# Auth / Event object storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Auth / Booking messaging
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
